#!/usr/bin/env bash
set -euo pipefail

SITE_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$SITE_DIR")"
SPEC_SOURCE="$REPO_DIR/SPEC.md"
SPEC_WEB_DIR="$SITE_DIR/content/spec/web"

# Split the canonical single-document spec into per-category pages under
# content/spec/web/ (the spec's own progressive disclosure recommendation:
# the full document exceeds the 100K truncation threshold its checks warn
# about). The /spec/ landing page (content/spec/_index.md) is hand-authored
# and not touched here.
rm -rf "$SPEC_WEB_DIR"
python3 "$SITE_DIR/split_spec.py" "$SPEC_SOURCE" "$SPEC_WEB_DIR"

# Run Hugo, passing through any arguments (e.g., "server")
cd "$SITE_DIR"
hugo "$@"
